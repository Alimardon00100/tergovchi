{
  "name": "detective-board",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test && node --test tests/assets.test.mjs tests/local-runtime.test.mjs tests/managed-services.test.mjs tests/installer.test.mjs",
    "test:db": "pnpm --filter @detective/api test:db",
    "test:http": "pnpm --filter @detective/api test:http",
    "test:browser": "node --env-file=.env tests/browser.smoke.mjs",
    "env:init": "node scripts/init-env.mjs",
    "db:generate": "pnpm --filter @detective/api db:generate",
    "db:validate": "pnpm --filter @detective/api db:validate",
    "db:migrate": "pnpm --filter @detective/api db:migrate",
    "db:seed": "pnpm --filter @detective/api db:seed",
    "db:verify": "pnpm --filter @detective/api db:verify",
    "start": "node scripts/start-local.mjs",
    "services:check": "node scripts/start-local.mjs --check",
    "services:stop": "node scripts/stop-local.mjs",
    "assets:import": "node scripts/import-assets.mjs",
    "assets:check": "node scripts/check-assets.mjs",
    "test:case-module": "pnpm --filter @detective/api test:case-module",
    "test:case-module:browser": "node --env-file=.env tests/case-module.browser.mjs",
    "test:case-module:coverage": "pnpm --filter @detective/api exec vitest run tests/case-scoring.test.ts --coverage --coverage.include=src/case-module/scoring.ts --coverage.reporter=text --coverage.reporter=json-summary",
    "openapi:case-module": "node scripts/generate-case-openapi.mjs",
    "backup:case-module": "node --env-file=.env apps/api/dist/scripts/backup.js",
    "test:case-module:exports": "node tests/case-module.exports.mjs",
    "test:case-opening:character": "pnpm --filter @detective/api exec dotenv -e ../../.env -- tsx scripts/test-database.ts --case-opening-character"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@napi-rs/canvas": "1.2.0",
    "@playwright/test": "1.65.1",
    "@types/node": "22.15.3",
    "docx-preview": "0.4.1",
    "embedded-postgres": "16.16.0-beta.19",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "pdfjs-dist": "6.5.438",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "turbo": "2.11.13",
    "typescript": "5.8.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
