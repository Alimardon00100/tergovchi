{
  "name": "@detective/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:db": "dotenv -e ../../.env -- tsx scripts/test-database.ts",
    "test:http": "dotenv -e ../../.env -- tsx scripts/test-database.ts --http",
    "db:generate": "prisma generate",
    "db:validate": "dotenv -e ../../.env -- prisma validate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:verify": "dotenv -e ../../.env -- tsx scripts/verify-database.ts",
    "test:case-module": "dotenv -e ../../.env -- tsx scripts/test-database.ts --case-module"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@detective/shared": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "9",
    "@fastify/static": "10.1.12",
    "@fontsource/noto-sans": "5.3.0",
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-fastify": "11.2.11",
    "@nestjs/throttler": "6",
    "@prisma/client": "5.22.0",
    "argon2": "0.41.1",
    "bcryptjs": "3",
    "docx": "9.16.0",
    "dotenv-cli": "8.0.0",
    "fastify": "5.12.8",
    "pdf-lib": "1.17.1",
    "pdfkit": "0.21.0",
    "pino": "9.6.0",
    "prisma": "5.22.0",
    "redis": "4.7.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "tar": "7.5.23",
    "tsx": "4.19.4",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@detective/config": "workspace:*",
    "@types/pdfkit": "0.17.7",
    "@vitest/coverage-v8": "5.1.1"
  }
}
