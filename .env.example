# managed: run.bat xizmatlarni o‘zi yaratadi va URL/parollarni avtomatik yozadi.
# external: mavjud serverlaringiz uchun haqiqiy URLlarni kiriting.
LOCAL_SERVICES=managed
DATABASE_URL=postgresql://detective:CHANGE_ME@127.0.0.1:15432/detective?schema=public
TEST_DATABASE_URL=postgresql://detective:CHANGE_ME@127.0.0.1:15432/detective_test?schema=public
REDIS_URL=redis://127.0.0.1:16379
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_NAME=Bosh tergovchi
SEED_ADMIN_PASSWORD=
# Case opening v2: default off. Stable user cohort: 10 for staging/canary, 100 for full rollout.
FF_CASE_OPENING_V2=false
FF_CASE_OPENING_V2_PERCENTAGE=100
